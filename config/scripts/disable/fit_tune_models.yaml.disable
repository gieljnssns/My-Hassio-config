emhass_fit_tune_models:
  alias: "EMHASS: Fit&tune Models"
  sequence:
    # Fit: Ridge
    - action: rest_command.forecast_model_fit_load_zonder_wp
      data:
        model_type: "load_forecast_ridge"
        model: "RidgeRegression"
    - delay:
        seconds: 5
    # Tune: Ridge
    # - action: rest_command.forecast_model_tune_load_zonder_wp
    #   data:
    #     model_type: "load_forecast_ridge"
    #     n_trials: 40
    # - delay:
    #     seconds: 5
    # Fit: LinearRegression
    - action: rest_command.forecast_model_fit_load_zonder_wp
      data:
        model_type: "load_forecast_linear"
        model: "LinearRegression"
    - delay:
        seconds: 5
    # Tune: LinearRegression
    # - action: rest_command.forecast_model_tune_load_zonder_wp
    #   data:
    #     model_type: "load_forecast_linear"
    #     n_trials: 40
    # - delay:
    #     seconds: 5
    # Fit: Lasso
    - action: rest_command.forecast_model_fit_load_zonder_wp
      data:
        model_type: "load_forecast_lasso"
        model: "LassoRegression"
    # - delay:
    #     seconds: 5
    # # Tune: Lasso
    # - action: rest_command.forecast_model_tune_load_zonder_wp
    #   data:
    #     model_type: "load_forecast_lasso"
    #     n_trials: 10


