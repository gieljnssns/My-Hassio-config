emhass_mpc_and_publish_test:
  alias: "EMHASS: MPC Optimization & Publish"
  variables:
    # Base MPC payload template (zonder model_type, die wordt per model toegevoegd)
    mpc_base: >
      {
        "entity_save": true,
        "prod_price_forecast": {{
          (state_attr('sensor.ecopower_injectieprijzen', 'prijzen')[:states('sensor.prediction_horizon') | int(0)]) | tojson
          }},
        "load_cost_forecast": {{
          (state_attr('sensor.ecopower_afnameprijzen', 'prijzen')[:states('sensor.prediction_horizon') | int(0)]) | tojson
          }},
        "pv_power_forecast": {{
          ([states('sensor.gemiddelde_opbrengst_5m')|int(0)] +
          state_attr('sensor.pv_power_forecast_list_interpolated', 'list')[:states('sensor.prediction_horizon') | int(0) - 1]) | tojson
          }},
        "prediction_horizon": {{ states('sensor.prediction_horizon') | int(0) }},
        "alpha": 1,
        "beta": 0,
        "num_def_loads": 5,
        "p_deferrable_nom": [2000, 2000, 1700, 900, 2000],
        "def_total_hours": [
          {{  [(states('sensor.wasmachien_uren')|float * 4) | round(0) / 4, 0] | max }},
          {{  [(states('sensor.droogkast_uren')|float * 4) | round(0) / 4, 0] | max }},
          {{  [(states('sensor.afwasmachien_uren')|float * 4) | round(0) / 4, 0] | max }},
          {{  [(states('sensor.warmtepompboiler_uren')|float * 4) | round(0) / 4, 0] | max }},
          {{  [(states('sensor.warmtepomp_uren') |float * 4) | round(0) / 4, 0] | max }}],
        "set_def_constant":[true, true, true, true, true],
        "def_start_timestep": [
          0,
          0,
          0,
          {{ states("sensor.warmtepompboiler_start_timesteps")}},
          {{ states("sensor.warmtepomp_start_timesteps")}}],
        "def_end_timestep": [
          {{ [ states('sensor.wasmachien_end_timesteps') | int(0), ((states('sensor.wasmachien_uren') | float * 4) | round(0) * 3) ] | max }},
          {{ [ states('sensor.droogkast_end_timesteps') | int(0), ((states('sensor.droogkast_uren') | float * 4) | round(0) * 3) ] | max }},
          {{ [ states('sensor.afwasmachien_end_timesteps') | int(0), ((states('sensor.afwasmachien_uren') | float * 4) | round(0) * 3) ] | max }},
          {{ [ states('sensor.warmtepompboiler_end_timesteps') | int(0), ((states('sensor.warmtepompboiler_uren') | float * 4) | round(0) * 3) ] | max }},
          {{ [ states('sensor.warmtepomp_end_timesteps') | int(0), ((states('sensor.warmtepompboiler_uren') | float * 4) | round(0) * 3) ] | max }}],
        "def_current_state": [
          {{  "true" if is_state('binary_sensor.wasmachien_staat_op', "on") else "false" }},
          {{  "true" if is_state('binary_sensor.droogkast_staat_op', "on") else "false" }},
          {{  "true" if is_state('binary_sensor.afwasmachien_staat_op', "on") else "false" }},
          {{  "true" if is_state('binary_sensor.warmtepompboiler_aan', "on") else "false" }},
          {{  "true" if is_state('binary_sensor.warmtepomp_aan', "on") else "false" }}],
        "soc_init": {{ states("sensor.battery_state_of_charge") | float(0) / 100 }},
        "battery_minimum_state_of_charge": {{ 
            states("sensor.soc_minimum") | float(0) if ((states("sensor.battery_state_of_charge") | float(0) / 100) > states("sensor.soc_minimum") | float(0)) 
            else (states("sensor.battery_state_of_charge") | float(0) / 100) }},
        "battery_maximum_state_of_charge": {{
          states("sensor.soc_maximum") | float(0) if ((states("sensor.battery_state_of_charge") | float(0) / 100) < states("sensor.soc_maximum") | float(0))
          else (states("sensor.battery_state_of_charge") | float(0) / 100) }},
        "soc_final": 0.7,
        "Pc_max": {{ states("sensor.battery_p_charge_max") }},
        "Pd_max": {{ states("sensor.battery_p_discharge_max") }}
      }
    # Model configuraties
    models:
      - name: "ElasticNet"
        suffix: "elasticnet"
        model_type: "load_forecast_elasticnet"
      - name: "LinearRegression"
        suffix: "linear"
        model_type: "load_forecast_linear"
      - name: "Ridge"
        suffix: "ridge"
        model_type: "load_forecast_ridge"
      - name: "Lasso"
        suffix: "lasso"
        model_type: "load_forecast_lasso"
  sequence:
    # # Alleen test modellen (productie is eruit gelaten)
    # - condition: state
    #   entity_id: input_boolean.emhass_testen
    #   state: "on"
    
    # Model 1: ElasticNet
    # - action: rest_command.naive_mpc_optim_test
    #   data:
    #     payload: >
    #       {{ mpc_base | replace('"alpha"', '"model_type": "' + models[0].model_type + '", "alpha"') }}
    # - delay:
    #     seconds: 2
    # - condition: state
    #   entity_id: input_boolean.emhass_publish_testen
    #   state: "on"
    # - action: rest_command.publish_data_test
    #   data:
    #     model_suffix: "{{ models[0].suffix }}"
    # - delay:
    #     seconds: 2
    
    # Model 2: LinearRegression
    - action: rest_command.naive_mpc_optim_test
      data:
        payload: >
          {{ mpc_base | replace('"alpha"', '"model_type": "' + models[1].model_type + '", "alpha"') }}
    - delay:
        seconds: 2
    # - if:
    #     - condition: state
    #       entity_id: input_boolean.emhass_publish_testen
    #       state: "on"
    #   then:
    #     - action: rest_command.publish_data_test
    #       data:
    #         model_suffix: "{{ models[1].suffix }}"
    # - delay:
    #     seconds: 2
    
    # Model 3: Ridge
    - action: rest_command.naive_mpc_optim_test
      data:
        payload: >
          {{ mpc_base | replace('"alpha"', '"model_type": "' + models[2].model_type + '", "alpha"') }}
    - delay:
        seconds: 2
    # - if:
    #     - condition: state
    #       entity_id: input_boolean.emhass_publish_testen
    #       state: "on"
    #   then:
    #     - action: rest_command.publish_data_test
    #       data:
    #         model_suffix: "{{ models[2].suffix }}"
    # - delay:
    #     seconds: 2
    
    # Model 4: Lasso
    - action: rest_command.naive_mpc_optim_test
      data:
        payload: >
          {{ mpc_base | replace('"alpha"', '"model_type": "' + models[3].model_type + '", "alpha"') }}
    - delay:
        seconds: 2
    # - if:
    #     - condition: state
    #       entity_id: input_boolean.emhass_publish_testen
    #       state: "on"
    #   then:
    #     - action: rest_command.publish_data_test
    #       data:
    #         model_suffix: "{{ models[3].suffix }}"

