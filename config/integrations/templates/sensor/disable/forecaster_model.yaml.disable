          {% endif -%}

# =============================================================================
# BESTE MODEL SENSOREN
# =============================================================================

# BESTE MODEL - 24H
- trigger:
    - trigger: time_pattern
      minutes: /30
  sensor:
    - name: "Best EMHASS Model Load (24h)"
      unique_id: best_emhass_model_load_24h
      state: >
        {% set errors = {
          'Ridge': states('sensor.emhass_load_error_ridge_daily_avg') | float(9999),
          'Lasso': states('sensor.emhass_load_error_lasso_daily_avg') | float(9999),
          'Linear': states('sensor.emhass_load_error_linear_daily_avg') | float(9999)
        } -%}
        {{ errors.items() | selectattr('1', 'equalto', errors.values() | list | min) | map(attribute='0') | first }}
      attributes:
        ridge_error: "{{ states('sensor.emhass_load_error_ridge_daily_avg') }}"
        lasso_error: "{{ states('sensor.emhass_load_error_lasso_daily_avg') }}"
        linear_error: "{{ states('sensor.emhass_load_error_linear_daily_avg') }}"
        ranking: >
          {% set errors = {
            'Ridge': states('sensor.emhass_load_error_ridge_daily_avg') | float(9999),
            'Lasso': states('sensor.emhass_load_error_lasso_daily_avg') | float(9999),
            'Linear': states('sensor.emhass_load_error_linear_daily_avg') | float(9999)
          } -%}
          {{ errors | dictsort(by='value') | map(attribute='0') | list }}

# BESTE MODEL - 7 DAGEN
- trigger:
    - trigger: time_pattern
      hours: /1
  sensor:
    - name: "Best EMHASS Model Load (7d)"
      unique_id: best_emhass_model_load_7d
      state: >
        {% set errors = {
          'Ridge': states('sensor.emhass_load_error_ridge_weekly_avg') | float(9999),
          'Lasso': states('sensor.emhass_load_error_lasso_weekly_avg') | float(9999),
          'Linear': states('sensor.emhass_load_error_linear_weekly_avg') | float(9999)
        } -%}
        {{ errors.items() | selectattr('1', 'equalto', errors.values() | list | min) | map(attribute='0') | first }}
      attributes:
        ridge_error: "{{ states('sensor.emhass_load_error_ridge_weekly_avg') }}"
        lasso_error: "{{ states('sensor.emhass_load_error_lasso_weekly_avg') }}"
        linear_error: "{{ states('sensor.emhass_load_error_linear_weekly_avg') }}"
        ranking: >
          {% set errors = {
            'Ridge': states('sensor.emhass_load_error_ridge_weekly_avg') | float(9999),
            'Lasso': states('sensor.emhass_load_error_lasso_weekly_avg') | float(9999),
            'Linear': states('sensor.emhass_load_error_linear_weekly_avg') | float(9999)
          } -%}
          {{ errors | dictsort(by='value') | map(attribute='0') | list }}
        improvement_vs_24h: >
          {% set model_24h = states('sensor.best_emhass_model_load_24h') -%}
          {% set model_7d = states('sensor.best_emhass_model_load_7d') -%}
          {% if model_24h == model_7d -%}
            Consistent winner
          {% else -%}
            Different: 24h={{ model_24h }}, 7d={{ model_7d }}
          {% endif -%}
