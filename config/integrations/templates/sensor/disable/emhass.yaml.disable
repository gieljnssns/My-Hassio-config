    - name: Prediction horizon
      unique_id: 39144142-06b5-4c2a-897a-d24b0c8fd2e4
      unit_of_measurement: 5m
      availability: >
        {{ state_attr('sensor.ecopower_afnameprijzen', 'prijzen') | length | is_number }}
      state: >
        {% set prijzen = state_attr('sensor.ecopower_afnameprijzen', 'prijzen') -%}
        {% set total = prijzen | length if prijzen is iterable else 288 -%}
        {% set droogkast = states("sensor.droogkast_end_timesteps") | int(0) if states("sensor.droogkast_end_timesteps") | int(0) < total else total -%}
        {% set wasmachien = states("sensor.wasmachien_end_timesteps") | int(0) if states("sensor.wasmachien_end_timesteps") | int(0) < total else total -%}
        {% set afwasmachien = states("sensor.afwasmachien_end_timesteps") | int(0) if states("sensor.afwasmachien_end_timesteps") | int(0) < total else total -%}
        {% set endstep = max(droogkast, wasmachien, afwasmachien) -%}

        {% set hour = now().hour -%}
        {% set minute = now().minute -%}
        {% set block = hour * 12 + (minute // 5) -%}
        {% set remaining = 288 - block -%}

        {% if hour >= 20 or hour < 7 -%}
          {{ ([216, total] | min, endstep) | max }}
        {% else -%}
          {{ ([remaining, total] | min, endstep) | max }}
        {% endif -%}

    - name: Prediction horizon span
      unique_id: 4413a66d-72e7-498b-9a9d-56eb43907fae
      state: >
        {% set horizon = states("sensor.prediction_horizon")|int(0) -%}
        {{ (((horizon*5)-30)|int(0)|string + "min")|string }}

    - name: Emhass mpc
      unique_id: ae62fe7e-6481-460d-a998-141e120f63ad
      state: 0
      attributes:
        mpc: >
          {
            "entity_save": true,
            "prod_price_forecast": {{
              (state_attr('sensor.ecopower_injectieprijzen', 'prijzen')[:states('sensor.prediction_horizon') | int(0)]) | tojson
              }},
            "load_cost_forecast": {{
              (state_attr('sensor.ecopower_afnameprijzen', 'prijzen')[:states('sensor.prediction_horizon') | int(0)]) | tojson
              }},
            "pv_power_forecast": {{
              ([states('sensor.gemiddelde_opbrengst_5m')|int(0)] +
              state_attr('sensor.pv_power_forecast_list', 'list')[:states('sensor.prediction_horizon') | int(0) - 1]) | tojson
              }},
            "prediction_horizon": {{ states('sensor.prediction_horizon') | int(0) }},
            "model_type": "load_forecast",
            "alpha": 1,
            "beta": 0,
            "num_def_loads": 5,
            "p_deferrable_nom": [2000, 2000, 1700, 900, 2000],
            "def_total_hours": [
              {{  (states('sensor.wasmachien_uren')|float * 4) | round(0) / 4 }},
              {{  (states('sensor.droogkast_uren')|float * 4) | round(0) / 4 }},
              {{  (states('sensor.afwasmachien_uren')|float * 4) | round(0) / 4 }},
              {{  (states('sensor.warmtepompboiler_uren')|float * 4) | round(0) / 4}},
              {{  (0 |float * 4) | round(0) / 4 }}],
            "set_def_constant":[true, true, true, true, true],
            "def_start_timestep": [
              0,
              0,
              0,
              {% if (as_timestamp(now()) - states("sensor.warmtepompboiler_is_gestopt_op")|float(0)) < 1500 -%}
                6
              {% else -%}
                0
              {% endif -%},
              0],
            "def_end_timestep": [
              {{ [ states('sensor.wasmachien_end_timesteps') | int(0), ((states('sensor.wasmachien_uren') | float * 4) | round(0) * 3) ] | max }},
              {{ [ states('sensor.droogkast_end_timesteps') | int(0), ((states('sensor.droogkast_uren') | float * 4) | round(0) * 3) ] | max }},
              {{ [ states('sensor.afwasmachien_end_timesteps') | int(0), ((states('sensor.afwasmachien_uren') | float * 4) | round(0) * 3) ] | max }},
              {{ [ states('sensor.warmtepompboiler_end_timesteps') | int(0), ((states('sensor.warmtepompboiler_uren') | float * 4) | round(0) * 3) ] | max }},
              0],
            "def_current_state": [
              {{  "true" if is_state('input_boolean.emhass_wasmachien', "on") else "false" }}, 
              {{  "true" if is_state('input_boolean.emhass_droogkast', "on") else "false" }}, 
              {{  "true" if is_state('input_boolean.emhass_afwasmachien', "on") else "false" }}, 
              {{  "true" if is_state('binary_sensor.warmtepompboiler_aan', "on") else "false" }}, 
              {{  "true" if is_state('input_boolean.emhass_warmtepomp', "on") else "false" }}],
            "soc_init": {{ states("sensor.battery_state_of_charge") | float(0) / 100 }},
            "soc_final": 0.5,
            "Pc_max": 7000
          }
# ,
#             "soc_init": {{ states("sensor.battery_state_of_charge") | float(0) / 100 }},
#             "soc_final": 0.6
# "def_end_timestep": [
#   {{ [ states('sensor.wasmachien_end_timesteps') | int(0), ((states('sensor.wasmachien_uren') | float * 4) | round(0) * 3 + 2) ] | max }},
#   {{ [ states('sensor.droogkast_end_timesteps') | int(0), ((states('sensor.droogkast_uren') | float * 4) | round(0) * 3 + 2) ] | max }},
#   {{ [ states('sensor.afwasmachien_end_timesteps') | int(0), ((states('sensor.afwasmachien_uren') | float * 4) | round(0) * 3 + 2) ] | max }},
#   {{ [ states('sensor.warmtepompboiler_end_timesteps') | int(0), ((states('sensor.warmtepompboiler_uren') | float * 4) | round(0) * 3 + 2) ] | max }},
#   0
# ],
# "def_end_timestep": [
#               {{  states('sensor.wasmachien_end_timesteps') | int(0) }},
#               {{  states('sensor.droogkast_end_timesteps') | int(0) }},
#               {{  states('sensor.afwasmachien_end_timesteps') | int(0) }},
#               {{  states('sensor.warmtepompboiler_end_timesteps') | int(0) }},
#               0],

    - name: Days to retrieve
      unique_id: 175a282e-93d8-428a-b702-954438886b79
      unit_of_measurement: days
      state: >
        {% from 'easy_time.jinja' import count_the_days -%}
        {% set days = count_the_days("2025-07-16 00:00:00") | int(0) -%}
        {{ (days * -1) - 1 }}
    
    - name: Dynamische maximum laadvermogen batterij
      unique_id: 61f8749c-834a-4dbe-b43d-fd516d4d5575
      unit_of_measurement: W
      state: >
        {% set pv_power = states('sensor.huidige_opbrengst') | float(0) -%}
        {% set house_load = states('sensor.huidig_verbruik') | float(0) -%}
        {% set max_grid_import = 3000 -%}
        {% set max_battery_power = 8000 -%}
        {% set available_pv = pv_power - house_load -%}
        {% set max_charge_power = available_pv + max_grid_import -%}
        {% if max_charge_power > max_battery_power -%}
          {{ max_battery_power }}
        {% elif max_charge_power < 0 -%}
          0
        {% else -%}
          {{ max_charge_power | round(0) }}
        {% endif -%}
    
    - name: Soc final
      unique_id: 688b6bb9-f43d-4c15-b4b5-6b951525da9b
      state: >
        {% set tomorrow_pv_forecast = (states('sensor.open_meteo_voorspelling_morgen') | float(0) + states("sensor.solcast_solaredge_forecast_tomorrow") | float ) / 2 -%}
          {% set tomorrow_max_temp = states('sensor.maximum_temperatuur_morgen') -%}
          {% if tomorrow_max_temp != 'unknown' and tomorrow_max_temp != 'unavailable' -%}
            {% set weather_data = state_attr('sensor.weather_forecast_daily', 'forecast') -%}
            {% if weather_data and weather_data|length > 0 -%}
              {% set tomorrow_temp = weather_data[0].temperature | float(15) -%}
            {% else -%}
              {% set tomorrow_temp = states('sensor.openweathermap_forecast_temperature') | float(15) -%}
            {% endif -%}
          {% else -%}
            {% set tomorrow_temp = 15 -%}
          {% endif -%}
          {% if tomorrow_pv_forecast > 33 -%}
            {% set pv_category = 'hoog' -%}
          {% elif tomorrow_pv_forecast > 18 -%}
            {% set pv_category = 'medium' -%}
          {% else -%}
            {% set pv_category = 'laag' -%}
          {% endif -%}
          {% if tomorrow_temp > 20 -%}
            {% set temp_category = 'warm' -%}
          {% elif tomorrow_temp > 10 -%}
            {% set temp_category = 'mild' -%}
          {% else -%}
            {% set temp_category = 'koud' -%}
          {% endif -%}
          {# Beslissingslogica voor final SOC #}
          {% if pv_category == 'hoog' and temp_category in ['warm', 'mild'] -%}
            {# Veel zon morgen + niet koud = lage SOC, ruimte voor PV opslag #}
            {{ 0.85 }}
          {% elif pv_category == 'hoog' and temp_category == 'koud' -%}
            {# Veel zon + koud = medium SOC, balans tussen PV en warmtepomp #}
            {{ 0.45 }}
          {% elif pv_category == 'medium' and temp_category == 'warm' -%}
            {# Medium zon + warm = lage SOC #}
            {{ 0.55 }}
          {% elif pv_category == 'medium' and temp_category in ['mild', 'koud'] -%}
            {# Medium zon + koud = medium-hoge SOC voor warmtepomp #}
            {{ 0.25 }}
          {% elif pv_category == 'laag' and temp_category in ['warm', 'mild'] -%}
            {# Weinig zon + niet zo koud = medium SOC #}
            {{ 0.35 }}
          {% elif pv_category == 'laag' and temp_category == 'koud' -%}
            {# Weinig zon + koud = hoge SOC, veel energie voor warmtepomp #}
            {{ 0.15 }}
          {% else -%}
            {{ 0.50 }}
          {% endif -%}

    - name: Solcast pv list
      unique_id: 51dacdf6-b9c7-4497-b4c0-25fb2ac5c11c
      state: >
        {{ states("sensor.solcast_solaredge_forecast_today") }}
      attributes:
        prediction: >
          {% set forecast_today = state_attr('sensor.solcast_solaredge_forecast_today','detailedForecast') -%}
          {% set forecast_tomorrow = state_attr('sensor.solcast_solaredge_forecast_tomorrow','detailedForecast') -%}
          {% set full = forecast_today + forecast_tomorrow -%}
          {% set upcoming = full | selectattr('period_start', 'gt', utcnow()) | list -%}
          {% set ns = namespace(values=[]) -%}
          {% for i in range(upcoming|count - 1) -%}
            {% set t1 = upcoming[i]["pv_estimate"] | float -%}
            {% set t2 = upcoming[i+1]["pv_estimate"] | float -%}
            {% for step in range(6) -%}
              {% set val = t1 + (t2 - t1) * (step / 6) -%}
              {% set ns.values = ns.values + [ (val * 1000) | round(0) ] -%}
            {% endfor -%}
          {% endfor -%}
          {{ ns.values[:288] }}
        history: >
          {% set forecast_today = state_attr('sensor.solcast_solaredge_forecast_today','detailedForecast') -%}
          {% set past_and_current = forecast_today | selectattr('period_start', 'lt', now()) | list -%}
          {% set ns = namespace(values=[]) -%}
          {% for i in range(past_and_current|count - 1) -%}
            {% set t1 = past_and_current[i]["pv_estimate"] | float * 1000 -%}
            {% set t2 = past_and_current[i+1]["pv_estimate"] | float * 1000 -%}
            {% for step in range(6) -%}
              {% set val = t1 + (t2 - t1) * (step / 6) -%}
              {% set ns.values = ns.values + [ val | round(0) ] -%}
            {% endfor -%}
          {% endfor -%}
          {{ ns.values }}
        prediction10: >
          {% set forecast_today = state_attr('sensor.solcast_solaredge_forecast_today','detailedForecast') -%}
          {% set forecast_tomorrow = state_attr('sensor.solcast_solaredge_forecast_tomorrow','detailedForecast') -%}
          {% set full = forecast_today + forecast_tomorrow -%}
          {% set upcoming = full | selectattr('period_start', 'gt', utcnow()) | list -%}
          {% set ns = namespace(values=[]) -%}
          {% for i in range(upcoming|count - 1) -%}
            {% set t1 = upcoming[i]["pv_estimate10"] | float -%}
            {% set t2 = upcoming[i+1]["pv_estimate10"] | float -%}
            {% for step in range(6) -%}
              {% set val = t1 + (t2 - t1) * (step / 6) -%}
              {% set ns.values = ns.values + [ (val * 1000) | round(0) ] -%}
            {% endfor -%}
          {% endfor -%}
          {{ ns.values[:288] }}
        history10: >
          {% set forecast_today = state_attr('sensor.solcast_solaredge_forecast_today','detailedForecast') -%}
          {% set past_and_current = forecast_today | selectattr('period_start', 'lt', now()) | list -%}
          {% set ns = namespace(values=[]) -%}
          {% for i in range(past_and_current|count - 1) -%}
            {% set t1 = past_and_current[i]["pv_estimate10"] | float * 1000 -%}
            {% set t2 = past_and_current[i+1]["pv_estimate10"] | float * 1000 -%}
            {% for step in range(6) -%}
              {% set val = t1 + (t2 - t1) * (step / 6) -%}
              {% set ns.values = ns.values + [ val | round(0) ] -%}
            {% endfor -%}
          {% endfor -%}
          {{ ns.values }}
        prediction90: >
          {% set forecast_today = state_attr('sensor.solcast_solaredge_forecast_today','detailedForecast') -%}
          {% set forecast_tomorrow = state_attr('sensor.solcast_solaredge_forecast_tomorrow','detailedForecast') -%}
          {% set full = forecast_today + forecast_tomorrow -%}
          {% set upcoming = full | selectattr('period_start', 'gt', utcnow()) | list -%}
          {% set ns = namespace(values=[]) -%}
          {% for i in range(upcoming|count - 1) -%}
            {% set t1 = upcoming[i]["pv_estimate90"] | float -%}
            {% set t2 = upcoming[i+1]["pv_estimate90"] | float -%}
            {% for step in range(6) -%}
              {% set val = t1 + (t2 - t1) * (step / 6) -%}
              {% set ns.values = ns.values + [ (val * 1000) | round(0) ] -%}
            {% endfor -%}
          {% endfor -%}
          {{ ns.values[:288] }}
        history90: >
          {% set forecast_today = state_attr('sensor.solcast_solaredge_forecast_today','detailedForecast') -%}
          {% set past_and_current = forecast_today | selectattr('period_start', 'lt', now()) | list -%}
          {% set ns = namespace(values=[]) -%}
          {% for i in range(past_and_current|count - 1) -%}
            {% set t1 = past_and_current[i]["pv_estimate90"] | float * 1000 -%}
            {% set t2 = past_and_current[i+1]["pv_estimate90"] | float * 1000 -%}
