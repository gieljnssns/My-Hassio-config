- sensor:
    - name: "Ecopower Afnameprijzen"
      unique_id: 16ccc75e-d8ab-4b79-ad3a-af3d289b1724
      unit_of_measurement: "EUR/kWh"
      state: >
        {% set factor_A = 1.02 -%}
        {% set factor_B = 0.004 -%}
        {% set GSC = 0.011 -%}
        {% set WKC = 0.00392 -%}
        {% set nettarief = 0.0565101 -%}
        {% set heffing = 0.0019261 -%}
        {% set accijns = 0.04748 -%}
        {% set VAT_scaling = 1.06 -%}       
        {% set today = now().strftime('%Y-%m-%d') -%}
        {% set tomorrow = (now().timestamp() + 86400) | timestamp_custom('%Y-%m-%d') -%}
        {% set quarter_index = (now().minute // 5) -%}
        {% set current_hour = now().hour -%}
        {% set today_prices = (state_attr('sensor.average_electricity_price', 'prices')
            | selectattr('time', 'search', today)
            | map(attribute='price')
            | list)[current_hour:] -%}
        {% set tomorrow_prices = (state_attr('sensor.average_electricity_price', 'prices')
            | selectattr('time', 'search', tomorrow)
            | map(attribute='price')
            | list) -%}
        {% set all_prices = today_prices + tomorrow_prices -%}
        {% set ns = namespace(z=[]) -%}
        {% for price in all_prices -%}
          {% set ns.z = ns.z + [price] * 12 -%}
        {% endfor -%}
        {% set start = quarter_index -%}
        {% set prices = ns.z[start:start + 288] -%}
        {{ ((prices[0] * factor_A + factor_B + GSC + WKC + nettarief + heffing + accijns) * VAT_scaling) | round(5) }}
      attributes:
        prijzen: >
          {% set factor_A = 1.02 -%}
          {% set factor_B = 0.004 -%}
          {% set GSC = 0.011 -%}
          {% set WKC = 0.00392 -%}
          {% set nettarief = 0.0565101 -%}
          {% set heffing = 0.0019261 -%}
          {% set accijns = 0.04748 -%}
          {% set VAT_scaling = 1.06 -%}
          {% set today = now().strftime('%Y-%m-%d') -%}
          {% set tomorrow = (now().timestamp() + 86400) | timestamp_custom('%Y-%m-%d') -%}
          {% set quarter_index = (now().minute // 5) -%}
          {% set current_hour = now().hour -%}
          {% set today_prices = (state_attr('sensor.average_electricity_price', 'prices')
              | selectattr('time', 'search', today)
              | map(attribute='price')
              | list)[current_hour:] -%}
          {% set tomorrow_prices = (state_attr('sensor.average_electricity_price', 'prices')
              | selectattr('time', 'search', tomorrow)
              | map(attribute='price')
              | list) -%}
          {% set all_prices = today_prices + tomorrow_prices -%}
          {% set ns = namespace(z=[]) -%}
          {% for price in all_prices -%}
            {% set ns.z = ns.z + [price] * 12 -%}
          {% endfor -%}
          {% set start = quarter_index -%}
          {% set prices = ns.z[start:start + 288] -%}
          {{ prices | map('float') 
                    | map('multiply', factor_A) 
                    | map('add', factor_B) 
                    | map('add', GSC) 
                    | map('add', WKC)
                    | map('add', nettarief) 
                    | map('add', heffing) 
                    | map('add', accijns)
                    | map('multiply', VAT_scaling) 
                    | map('round', 5) | list }}


    - name: "Ecopower Injectieprijzen"
      unique_id: 98d961f2-497a-440a-865b-bf2fe1897218
      unit_of_measurement: "EUR/kWh"
      state: >
        {% set factor_C = 0.98 -%}
        {% set factor_D = -0.015 -%}
        {% set today = now().strftime('%Y-%m-%d') -%}
        {% set tomorrow = (now().timestamp() + 86400) | timestamp_custom('%Y-%m-%d') -%}
        {% set quarter_index = (now().minute // 5) -%}
        {% set current_hour = now().hour -%}
        {% set today_prices = (state_attr('sensor.average_electricity_price', 'prices')
            | selectattr('time', 'search', today)
            | map(attribute='price')
            | list)[current_hour:] -%}
        {% set tomorrow_prices = (state_attr('sensor.average_electricity_price', 'prices')
            | selectattr('time', 'search', tomorrow)
            | map(attribute='price')
            | list) -%}
        {% set all_prices = today_prices + tomorrow_prices -%}
        {% set ns = namespace(z=[]) -%}
        {% for price in all_prices -%}
          {% set ns.z = ns.z + [price] * 12 -%}
        {% endfor -%}
        {% set start = quarter_index -%}
        {% set prices = ns.z[start:start + 288] -%}
        {{ (prices[0] * factor_C + factor_D) | round(5) }}
      attributes:
        prijzen: >
          {% set factor_C = 0.98 -%}
          {% set factor_D = -0.015 -%}
          {% set today = now().strftime('%Y-%m-%d') -%}
          {% set tomorrow = (now().timestamp() + 86400) | timestamp_custom('%Y-%m-%d') -%}
          {% set quarter_index = (now().minute // 5) -%}
          {% set current_hour = now().hour -%}
          {% set today_prices = (state_attr('sensor.average_electricity_price', 'prices')
              | selectattr('time', 'search', today)
              | map(attribute='price')
              | list)[current_hour:] -%}
          {% set tomorrow_prices = (state_attr('sensor.average_electricity_price', 'prices')
              | selectattr('time', 'search', tomorrow)
              | map(attribute='price')
              | list) -%}
          {% set all_prices = today_prices + tomorrow_prices -%}
          {% set ns = namespace(z=[]) -%}
          {% for price in all_prices -%}
            {% set ns.z = ns.z + [price] * 12 -%}
          {% endfor -%}
          {% set start = quarter_index -%}
          {% set prices = ns.z[start:start + 288] -%}
          {{ prices | map('float') | map('multiply', factor_C) | map('add', factor_D) | map('round', 5) | list }}
    
    - name: "Price list length"
      unique_id: 3ac05511-a002-4d3a-b104-2d57ada50d07
      unit_of_measurement: "st"
      state: >
        {% set today = now().strftime('%Y-%m-%d') -%}
        {% set tomorrow = (now().timestamp() + 86400) | timestamp_custom('%Y-%m-%d') -%}
        {% set quarter_index = (now().minute // 5) -%}
        {% set current_hour = now().hour -%}
        {% set today_prices = (state_attr('sensor.average_electricity_price', 'prices')
            | selectattr('time', 'search', today)
            | map(attribute='price')
            | list)[current_hour:] -%}
        {% set tomorrow_prices = (state_attr('sensor.average_electricity_price', 'prices')
            | selectattr('time', 'search', tomorrow)
            | map(attribute='price')
            | list) -%}
        {% set all_prices = today_prices + tomorrow_prices -%}
        {% set ns = namespace(z=[]) -%}
        {% for price in all_prices -%}
          {% set ns.z = ns.z + [price] * 12 -%}
        {% endfor -%}
        {% set start = quarter_index -%}
        {% set prices = ns.z[start:] -%}
        {{ prices | length }}
    
    - name: "Wasmachien uren"
      unique_id: c7278411-c766-4fcd-81ea-0604db1b1f76
      unit_of_measurement: "uur"
      state: >
        {% if states("input_boolean.wasmachien_starten") == 'on' -%}
          {% if states("switch.wasmachien") == 'off' -%}
            2
          {% elif states("input_boolean.emhass_wasmachien") == 'on' -%}
            {% if (2 - ((as_timestamp(now()) - states("sensor.wasmachien_is_gestart_op") | float(0)) / 3600) | round(1)) | float(0) > 0  -%}
              {{ 2 - ((as_timestamp(now()) - states("sensor.wasmachien_is_gestart_op") | float(0)) / 3600) | round(1) }}
            {% else -%}
              0
            {% endif -%}
          {% else -%}
            0
          {% endif -%}
        {% else -%}
          0
        {% endif -%}
    
    - name: Wasmachien startuur
      unique_id: 12e7093b-ea97-4f69-a47d-720106331e9f
      state: >
        {% from 'easy_time.jinja' import easy_relative_time -%}
        {% set load = (state_attr('sensor.emhass_wasmachien', 'deferrables_schedule')
                |map(attribute='emhass_wasmachien')
                |list) -%}
        {% set time = (state_attr('sensor.emhass_wasmachien', 'deferrables_schedule')
                |map(attribute='date')
                |list) -%}
        {% if is_state("input_boolean.emhass_wasmachien", "on") -%}
          Staat op
        {% else -%}
          {% set new_list = namespace(all=[]) -%}
            {% for i in range (load | length) -%}
              {% if load[i] | float(0) > 1 -%}
                {{ (easy_relative_time(time [i], max_period='minute', language='nl')) }}
                {% break -%}
              {% endif -%}
            {% endfor -%}
        {% endif -%}
      availability: >-
        {{ states('sensor.emhass_wasmachien') | is_number }}
    
    - name: Wasmachien end timesteps
      unique_id: 0c02daa5-efbc-4156-9ada-f402a878194a
      unit_of_measurement: 5m
      state: >
        {% set steps = (((states("input_datetime.emhass_wasmachien_end_time") | as_timestamp) - now() | as_timestamp) / 300) -%}
        {% set hours_to_operate = states("sensor.wasmachien_uren") | float(0) -%}
        {% set op_blocks = (hours_to_operate * 12) | round(0, 'ceil') -%}
        {% if is_state("input_boolean.wasmachien_starten", "on") -%}
          {% if is_state('input_boolean.emhass_wasmachien', "on") -%}
            {{ op_blocks }}
          {% else -%}
            {{ max(op_blocks, steps|int, 0) }}
          {% endif -%} 
        {% else -%}
          0
        {% endif -%}

    - name: "Droogkast uren"
      unique_id: 59e14f81-ccd8-4099-b08d-d21c53ff3c70
      unit_of_measurement: "uur"
      state: >
        {% if states("input_boolean.droogkast_starten") == 'on' -%}
          {% if states("switch.droogkast") == 'off' and states("input_boolean.wasmachien_starten") == 'on' and states("input_boolean.afwasmachien_starten") == 'on' -%}
            6
          {% elif states("switch.droogkast") == 'off' and states("input_boolean.wasmachien_starten") == 'on' -%}
            4
          {% elif states("switch.droogkast") == 'off' and states("input_boolean.afwasmachien_starten") == 'on' -%}
            4
          {% elif states("switch.droogkast") == 'off' -%}
            2
          {% elif states("input_boolean.emhass_droogkast") == 'on' -%}
            {% if (2 - ((as_timestamp(now()) - states("sensor.droogkast_is_gestart_op") | float(0)) / 3600) | round(1)) | float(0) > 0  -%}
              {{ 2 - ((as_timestamp(now()) - states("sensor.droogkast_is_gestart_op") | float(0)) / 3600) | round(1) }}
            {% else -%}
              0
            {% endif -%}
          {% else -%}
            0
          {% endif -%}
        {% else -%}
          0
        {% endif -%}
    
