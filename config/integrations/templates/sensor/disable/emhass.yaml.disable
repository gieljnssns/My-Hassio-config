        {% set hours_to_operate = states("sensor.afwasmachien_uren") | float(0) -%}
        {% set op_blocks = (hours_to_operate * 12) | round(0, 'ceil') -%}
        {% if is_state("input_boolean.afwasmachien_starten", "on") -%}
