    - name: OpenMeteo pv list
      unique_id: 34cbc9ab-559d-4c47-9d86-31611e8eac1b
      state: >
        {{ states("sensor.open_meteo_voorspelling_vandaag") }}
      attributes:
        prediction: >
          {% set data = state_attr('sensor.open_meteo_voorspelling_vandaag', 'watts') -%}
          {% set data2 = state_attr('sensor.open_meteo_voorspelling_morgen', 'watts') -%}
          {% if data is not none and data2 is not none -%}
            {% set now_ts = as_timestamp(now()) -%}
            {% set items = (data.items() | list) | sort(attribute=0) -%}
            {% set items2 = (data2.items() | list) | sort(attribute=0) -%}
            {% set all_items = items + items2 -%}

            {% set ns = namespace(result=[]) -%}

            {% for i in range(all_items | length - 1) -%}
              {% set ts1, val1 = all_items[i] -%}
              {% set ts2, val2 = all_items[i+1] -%}
              {% set t1 = as_timestamp(as_datetime(ts1)) -%}
              {% set t2 = as_timestamp(as_datetime(ts2)) -%}
              {% if t1 >= now_ts and (t2 - t1) == 900 -%}
                {% set v1 = val1 | float | round(0) -%}
                {% set v2 = val2 | float -%}
                {% set val_5 = ((v1 * 2 + v2) / 3) | round(0) -%}
                {% set val_10 = ((v1 + v2 * 2) / 3) | round(0) -%}
                {% set ns.result = ns.result + [v1, val_5, val_10] -%}
              {% endif -%}
            {% endfor -%}
            {{ ns.result[:288] }}
          {% endif -%}
        history: >
          {% set data = state_attr('sensor.open_meteo_voorspelling_vandaag', 'watts') -%}
          {% if data is not none -%}
            {% set now_ts = as_timestamp(now()) -%}
            {% set midnight_ts = as_timestamp(today_at('00:00')) -%}
            {% set items = (data.items() | list) | sort(attribute=0) -%}

            {% set ns = namespace(result=[]) -%}

            {% for i in range(items | length - 1) -%}
              {% set ts1, val1 = items[i] -%}
              {% set ts2, val2 = items[i+1] -%}
              {% set t1 = as_timestamp(as_datetime(ts1)) -%}
              {% set t2 = as_timestamp(as_datetime(ts2)) -%}
              {% if t1 >= midnight_ts and t1 < now_ts and (t2 - t1) == 900 -%}
                {% set v1 = val1 | float | round(0) -%}
                {% set v2 = val2 | float -%}
                {% set val_5 = ((v1 * 2 + v2) / 3) | round(0) -%}
                {% set val_10 = ((v1 + v2 * 2) / 3) | round(0) -%}
                {% set ns.result = ns.result + [v1, val_5, val_10] -%}
              {% endif -%}
            {% endfor -%}
            {{ ns.result }}
          {% endif -%}

