    - name: "Warmtepomp uren"
      unique_id: 5c252e9e-ae09-4100-aace-8bb8d4149e8e
      unit_of_measurement: "uur"
      state: >
        {% set hours = states('input_number.voorspelde_uren')|float - states('sensor.branduren_warmtepomp')|float -%}
        {% set hour = now().hour -%}
        {% if 0 <= hour < 7 -%}
          0
        {% elif states("input_boolean.verwarming_starten") == 'on' -%}
          {% if states('input_number.voorspelde_uren')|float > 1 -%} 
            {{ hours }} 
          {% else -%} 
            0 
          {% endif -%}
        {% else -%}
          0
        {% endif -%}
    
    - name: Verwarming startuur
      unique_id: ceff5121-3392-4bac-8fa5-a8cec3e3d331
      state: >
        {% from 'easy_time.jinja' import easy_relative_time -%}
        {% set load = (state_attr('sensor.emhass_warmtepomp', 'deferrables_schedule')
                |map(attribute='emhass_warmtepomp')
                |list) -%}
        {% set time = (state_attr('sensor.emhass_warmtepomp', 'deferrables_schedule')
                |map(attribute='date')
                |list) -%}
        {% if is_state("input_boolean.emhass_warmtepomp", "on") -%}
          Staat op
        {% else -%}
          {% set new_list = namespace(all=[]) -%}
            {% for i in range (load | length) -%}
              {% if load[i] | float(0) > 1 -%}
                {{ (easy_relative_time(time [i], max_period='minute', language='nl')) }}
                {% break -%}
              {% endif -%}
            {% endfor -%}
          {% endif -%}
      availability: >-
        {{ states('sensor.emhass_warmtepomp') | is_number }}
    
    - name: Warmtepomp end timesteps
      unique_id: 2db655d5-f4d4-4687-a4e7-0029173bea99
      unit_of_measurement: 5m
      state: >
        {% set price_list = state_attr('sensor.ecopower_afnameprijzen', 'prijzen') -%}
        {% set price_list = price_list | length if price_list is iterable else 288 -%}
        {% set hour = now().hour -%}
        {% set minute = now().minute -%}
        {% set block = hour * 12 + (minute // 5) -%}
        {% set remaining = 288 - block -%}
        {% if hour >= 21 or hour < 7 -%}
          {{ [min(remaining, 216, price_list)] | min | int }}
        {% else -%}
          {{ [min(remaining, price_list)] | min | int }}
        {% endif -%}

    - name: Pv power forecast list
      unique_id: 6bc0c511-9c6f-4778-b13e-a20e3646a7e5
      state: >
        {{ states('input_text.best_solar_predictor') }}
      attributes:
        list: >
          {% set best_predictor = states('input_text.best_solar_predictor') -%}
          {% if best_predictor == "solcast" -%}
            {% set entity = "sensor.solcast_pv_list" -%}
            {% set attribute = "prediction" -%}
          {% elif best_predictor == "solcast10" -%}
            {% set entity = "sensor.solcast_pv_list" -%}
            {% set attribute = "prediction10" -%}
          {% elif best_predictor == "solcast90" -%}
            {% set entity = "sensor.solcast_pv_list" -%}
            {% set attribute = "prediction90" -%}
          {% elif best_predictor == "openmeteo" -%}
            {% set entity = "sensor.openmeteo_pv_list" -%}
            {% set attribute = "prediction" -%}
          {% endif -%}
          {{ state_attr(entity, attribute) }}
