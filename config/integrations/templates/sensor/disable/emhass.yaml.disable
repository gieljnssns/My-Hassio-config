        {% set hours_to_operate = states("sensor.droogkast_uren") | float(0) -%}
        {% set op_blocks = (hours_to_operate * 12) | round(0, 'ceil') -%}
        {% if is_state("input_boolean.droogkast_starten", "on") -%}
          {% if is_state('input_boolean.emhass_droogkast', "on") -%}
            {{ op_blocks }}
          {% else -%}
            {{ max(op_blocks, steps|int, 0) }}
          {% endif -%} 
        {% else -%}
          0
        {% endif -%}

    - name: "Afwasmachien uren"
